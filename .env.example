# ============================================================
# RepoShare Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=reposhare
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=reposhare

# For Docker Compose: use "db" as the hostname
# For local development: use "localhost"
DATABASE_URL=postgresql://reposhare:CHANGE_ME_TO_A_SECURE_PASSWORD@db:5432/reposhare

# ── Application ──────────────────────────────────────────────
# Public URL where RepoShare is accessible
# This is used for generating clone URLs and GitHub App callbacks
# Examples:
#   https://share.yourdomain.com   (production)
#   http://192.168.1.100:3000      (home lab)
#   http://localhost:3000           (development)
PUBLIC_URL=http://localhost:3000

# Auth secret for signing session tokens
# Generate with: openssl rand -base64 32
# If not set, a deterministic secret is derived from DATABASE_URL
NEXTAUTH_SECRET=

# Port to expose (only used by Docker Compose)
PORT=3000
